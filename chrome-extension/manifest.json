{
  "manifest_version": 3,
  "name": "广告报表同步助手",
  "version": "1.0.1",
  "description": "采集多平台广告报表并同步到多维表格",
  "permissions": [
    "activeTab",
    "storage",
    "debugger",
    "scripting"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.business.facebook.com/*",
    "*://*.adsmanager.facebook.com/*",
    "*://*.adsmanager-graph.facebook.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.business.facebook.com/*",
        "*://*.adsmanager.facebook.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.worker.js"
  }
}
